# BitcoinAll — demo / regtest credentials
# Source later with:  set -a; source demo/credentials.env; set +a
# WARNING: regtest/demo only. Do not use on networks with real value.

# --- RPC (both nodes) ---
BTCA_RPC_USER=btca
BTCA_RPC_PASSWORD=btca-demo

# --- Node 1 · Proposer ---
