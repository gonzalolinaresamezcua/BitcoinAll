BTCA_NODE1_RPC=http://127.0.0.1:18443
BTCA_NODE1_RPCPORT=18443
BTCA_NODE1_P2P=127.0.0.1:19444
BTCA_NODE1_P2PPORT=19444
BTCA_NODE1_ADDR=rbtca1qw508d6qejxtdg4y5r3zarvary0c5xw7k5c4835

# --- Node 2 · Validator ---
