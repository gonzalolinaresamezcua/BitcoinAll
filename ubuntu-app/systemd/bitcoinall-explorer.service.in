[Unit]
Description=BitcoinAll explorer web (puerto 9336)
Documentation=https://github.com/gonzalolinaresamezcua/BitcoinAll
After=network-online.target bitcoinall-node.service
Wants=network-online.target
Requires=bitcoinall-node.service

[Service]
Type=simple
User=__BITCOINALL_USER__
Group=__BITCOINALL_USER__
WorkingDirectory=__BITCOINALL_REPO__/explorer-app
Environment=BITCOINALL_DATADIR=__BITCOINALL_DATADIR__
Environment=BITCOINALL_WALLET=primera
Environment=BITCOINALL_EXPLORER_BIND=127.0.0.1
Environment=BITCOINALL_EXPLORER_PORT=9336
ExecStartPre=__BITCOINALL_HOME__/scripts/ensure-venv.sh explorer
ExecStart=__BITCOINALL_REPO__/explorer-app/.venv/bin/python __BITCOINALL_REPO__/explorer-app/server.py
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bitcoinall-explorer

[Install]
WantedBy=multi-user.target
