# Copia a data/bitcoin.conf al arrancar el nodo por primera vez:
#   mkdir -p data && cp bitcoin.conf.example data/bitcoin.conf

server=1
txindex=1
wallet=primera
port=9333
listen=1
# Bootstrap P2P: conecta automáticamente a nodos semilla al arrancar
seednode=84.120.58.166:9333
minrelaytxfee=0.01
incrementalrelayfee=0.01
